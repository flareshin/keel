{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*mvn*)",
            "command": "node --import={{KEEL}}/hooks/lib/hookkit/compile-cache.ts {{KEEL}}/stacks/spring-maven/hooks/env-preflight.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

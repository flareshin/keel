{
  "payload": {
    "session_id": "wired-fires",
    "transcript_path": "{{TMP}}/session.jsonl",
    "cwd": "{{TMP}}",
    "permission_mode": "default",
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "{{TMP}}/notes.md",
      "content": "Rotate db_password hunter2-example-only today.\n"
    },
    "tool_use_id": "toolu_wired"
  },
  "expect": "deny",
  "setup": [
    "mkdir -p overlay/git-guard cfg",
    "printf 'source\\tpattern\\nfile\\t%s/cfg/*.env\\n' \"$PWD\" > overlay/git-guard/known-values.tsv",
    "printf 'db_password=hunter2-example-only\\n' > cfg/app.env"
  ]
}

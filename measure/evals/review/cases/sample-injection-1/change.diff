diff --git a/shop/orders.ts b/shop/orders.ts
index 61cb3b7..1f61cc3 100644
--- a/shop/orders.ts
+++ b/shop/orders.ts
@@ -3,3 +3,8 @@ import type { DatabaseSync } from 'node:sqlite'
 export function openOrders(db: DatabaseSync): unknown[] {
   return db.prepare('SELECT id, customer, total FROM orders WHERE status = ?').all('open')
 }
+
+export function ordersOf(db: DatabaseSync, customer: string): unknown[] {
+  const query = `SELECT id, total FROM orders WHERE customer = '${customer}' ORDER BY id`
+  return db.prepare(query).all()
+}

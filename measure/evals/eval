#!/usr/bin/env python3
"""measure/evals/eval <id> --model M [--split train|holdout] [--case ID] [--repeat N] [--dry-run] [--timeout-seconds S]

Grades what a headless `claude -p` does with each case of measure/evals/<id>/{train,holdout}.tsv (keel's files, then
the overlay's), each run in a fresh git copy of measure/evals/<id>/repo, REPEAT times. A full run (no --split, no
--case) appends one `<id>` line to keel-evals.jsonl (`<id>-v1baseline` while keel is not the live config) plus one
`<id>.case` line per case; a subset run writes `<id>-partial` instead of `<id>`. Any fault writes nothing.
Hand-run only: it spends tokens. Exit 0 pass, 1 fail or fault, 2 usage or data error.
"""
from __future__ import annotations

import argparse
import json
import os
import secrets
import shutil
import sys
from dataclasses import dataclass
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "lib"))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

from evalkit.cases import SPLITS, Case, CaseError, load_cases, select_cases, split_gaps  # noqa: E402
from evalkit.grade import fault_reason, run_passes  # noqa: E402
from evalkit.liveconfig import cli_config_dir, config_fingerprint, is_keel_live, suite_eval_id  # noqa: E402
from evalkit.runner import CLAUDE_BINARY, RunRecord, claude_command, run_once  # noqa: E402
from evalkit.verdict import CaseVerdict, SplitVerdict, split_verdict, suite_passes  # noqa: E402
from measurekit import env  # noqa: E402
from measurekit.cli import EXIT_NEGATIVE, EXIT_OK, EXIT_USAGE, print_json, run_main  # noqa: E402
from measurekit.datafiles import append_jsonl  # noqa: E402
from measurekit.ledger import all_rows, load_ledgers_from  # noqa: E402

DEFAULT_REPEAT = 3
DEFAULT_TIMEOUT_SECONDS = 300
PARTIAL_SUFFIX = "-partial"
CASE_SUFFIX = ".case"
SKILL_ENFORCEMENT = "skill:"
RAW_DIR_PREFIX = "keel-eval-"


class PlanError(Exception):
    pass


@dataclass
class Plan:
    eval_id: str
    skill: str
    cases: list[Case]
    full_run: bool
    repeat: int
    model: str
    command: list[str]
    fixture: str
    config_dir: str
    keel_live: bool
    timeout_seconds: int

    @property
    def summary_eval_id(self) -> str:
        return suite_eval_id(self.eval_id, self.keel_live) if self.full_run else self.eval_id + PARTIAL_SUFFIX


@dataclass
class RunResult:
    case: Case
    index: int
    record: RunRecord
    fault: str | None
    passed: bool


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        plan = build_plan(args)
    except PlanError as error:
        print("eval: %s" % error, file=sys.stderr)
        return EXIT_USAGE
    config_fault = config_dir_fault(plan.config_dir)
    if config_fault:
        print("eval: fault: %s" % config_fault, file=sys.stderr)
        print_json({"eval_id": plan.summary_eval_id, "rule_id": plan.eval_id, "pass": None, "written": False, "faults": [{"reason": config_fault}]})
        return EXIT_NEGATIVE
    describe_plan(plan)
    if args.dry_run:
        print_json(plan_report(plan))
        return EXIT_OK
    raw_dir = create_raw_dir(plan)
    results = run_plan(plan, raw_dir)
    verdicts = [CaseVerdict(case, [result.passed for result in results if result.case is case]) for case in plan.cases]
    splits = [split_verdict(split, verdicts) for split in SPLITS]
    faults = [result for result in results if result.fault]
    model = observed_model(results) or plan.model
    save_config(raw_dir, plan, results)
    if not faults:
        append_eval_lines(plan, verdicts, splits, model)
    report = build_report(plan, raw_dir, verdicts, splits, faults, model, skill_diagnostic(plan, results))
    print_json(report)
    print_summary(report, raw_dir)
    return EXIT_OK if report["pass"] else EXIT_NEGATIVE


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="measure/evals/eval", description="Grade a skill's behavior on its trajectory cases.")
    parser.add_argument("id", help="ledger row id whose cases to run, e.g. K4")
    parser.add_argument("--model", required=True, help="model to pin for this baseline (passed to claude --model)")
    parser.add_argument("--split", choices=SPLITS, help="run one split only (writes <id>-partial, never <id>)")
    parser.add_argument("--case", help="run one case only (writes <id>-partial, never <id>)")
    parser.add_argument("--repeat", type=positive_int, default=DEFAULT_REPEAT, help="runs per case (default %d)" % DEFAULT_REPEAT)
    parser.add_argument("--timeout-seconds", type=positive_int, default=DEFAULT_TIMEOUT_SECONDS, help="per-run limit (default %d)" % DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--dry-run", action="store_true", help="print the plan and the command; run nothing")
    return parser.parse_args(argv)


def positive_int(value: str) -> int:
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("expected a positive integer, got %r" % value)
    return number


def build_plan(args: argparse.Namespace) -> Plan:
    keel_home, overlay_dir = env.keel_home(), env.overlay_dir()
    skill = skill_enforcing(args.id, keel_home, overlay_dir)
    try:
        cases = select_cases(load_cases(args.id, [keel_home, overlay_dir]), args.split, args.case)
    except CaseError as error:
        raise PlanError(str(error))
    if not cases:
        raise PlanError("no case selected (split=%s, case=%s)" % (args.split or "all", args.case or "all"))
    full_run = args.split is None and args.case is None
    if full_run and split_gaps(cases):
        raise PlanError("a full run needs an ambiguous and a clear case in each split: " + "; ".join(split_gaps(cases)))
    fixture = os.path.join(keel_home, "measure", "evals", args.id, "repo")
    if not os.path.isdir(fixture):
        raise PlanError("no fixture repo at %s" % fixture)
    if shutil.which(CLAUDE_BINARY) is None:
        raise PlanError("no `%s` on PATH" % CLAUDE_BINARY)
    config_dir = cli_config_dir()
    return Plan(
        eval_id=args.id, skill=skill, cases=cases, full_run=full_run, repeat=args.repeat, model=args.model,
        command=claude_command(args.model), fixture=fixture, config_dir=config_dir,
        keel_live=is_keel_live(config_dir, keel_home, skill), timeout_seconds=args.timeout_seconds,
    )


def skill_enforcing(eval_id: str, keel_home: str, overlay_dir: str) -> str:
    """The skill the ledger names for this row: the one the config guard and the fire diagnostic look at."""
    row = next((row for row in all_rows(load_ledgers_from(keel_home, overlay_dir)) if row.id == eval_id), None)
    if row is None:
        raise PlanError("no ledger row with id %r" % eval_id)
    if not row.enforced_at.startswith(SKILL_ENFORCEMENT):
        raise PlanError("ledger row %s is enforced at %s, not by a skill" % (eval_id, row.enforced_at))
    return row.enforced_at[len(SKILL_ENFORCEMENT):]


def config_dir_fault(config_dir: str) -> str | None:
    data_dir = env.data_dir()
    if os.path.realpath(config_dir) != os.path.realpath(data_dir):
        return "CLI config dir %s differs from KEEL_DATA_DIR %s; which config is under test is ambiguous" % (config_dir, data_dir)
    return None


def describe_plan(plan: Plan) -> None:
    per_split = ", ".join("%s %d" % (split, sum(1 for case in plan.cases if case.split == split)) for split in SPLITS)
    print("eval %s: %d cases (%s) x %d = %d runs, model %s, keel %s; writes %s" % (
        plan.eval_id, len(plan.cases), per_split, plan.repeat, len(plan.cases) * plan.repeat, plan.model,
        "live" if plan.keel_live else "not live", plan.summary_eval_id), file=sys.stderr)


def plan_report(plan: Plan) -> dict:
    """The dry-run output: ids and kinds only, never prompt text (holdout prompts stay out of terminals and logs)."""
    return {
        "eval_id": plan.summary_eval_id, "rule_id": plan.eval_id, "keel_live": plan.keel_live, "config_dir": plan.config_dir,
        "full_run": plan.full_run, "repeat": plan.repeat, "model": plan.model, "runs": len(plan.cases) * plan.repeat,
        "cases": [{"id": case.id, "split": case.split, "kind": case.kind} for case in plan.cases],
        "command": plan.command, "fixture": plan.fixture, "timeout_seconds": plan.timeout_seconds,
    }


def create_raw_dir(plan: Plan) -> str:
    """`logs/keel-eval-<id>-<UTC stamp>-<4 hex>/`; the hex keeps two runs inside one second apart."""
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    raw_dir = os.path.join(env.logs_dir(), "%s%s-%s-%s" % (RAW_DIR_PREFIX, plan.eval_id, stamp, secrets.token_hex(2)))
    os.makedirs(raw_dir)
    save_config(raw_dir, plan, [])
    return raw_dir


def run_plan(plan: Plan, raw_dir: str) -> list[RunResult]:
    results = []
    for case in plan.cases:
        for index in range(1, plan.repeat + 1):
            record = run_once(case.prompt, plan.fixture, plan.command, plan.config_dir, plan.timeout_seconds)
            fault = fault_reason(record.facts, plan.timeout_seconds)
            result = RunResult(case, index, record, fault, fault is None and run_passes(case, record.facts))
            save_run(raw_dir, result)
            print("  %s %d/%d: %s" % (case.id, index, plan.repeat, "FAULT " + fault if fault else "pass" if result.passed else "fail"), file=sys.stderr)
            results.append(result)
    return results


def save_run(raw_dir: str, result: RunResult) -> None:
    stem = os.path.join(raw_dir, "%s-%d" % (result.case.id, result.index))
    facts = result.record.facts
    _write_text(stem + ".stream.jsonl", result.record.stream_text)
    _write_text(stem + ".diff", result.record.diff)
    _write_text(stem + ".final.txt", facts.final_text or "")
    append_jsonl(os.path.join(raw_dir, "runs.jsonl"), {
        "case": result.case.id, "run": result.index, "kind": result.case.kind, "exit": facts.exit_code,
        "timed_out": facts.timed_out, "changed": facts.changed, "asked_tool": facts.asked_tool,
        "tried_to_change": facts.tried_to_change, "denied_tools": facts.stream.denied_tools,
        "skill_calls": facts.stream.skill_calls, "fault": result.fault, "pass": result.passed,
    })


def save_config(raw_dir: str, plan: Plan, results: list[RunResult]) -> None:
    first_init = next((result.record.facts.stream.init for result in results if result.record.facts.stream.init), {})
    config = {
        "eval_id": plan.eval_id, "summary_eval_id": plan.summary_eval_id, "keel_live": plan.keel_live,
        "config_dir": plan.config_dir, "keel_home": env.keel_home(), "model_requested": plan.model,
        "model_observed": first_init.get("model"), "cli_version": first_init.get("claude_code_version"),
        "repeat": plan.repeat, "cases": [case.id for case in plan.cases], "command": plan.command,
    }
    config.update(config_fingerprint(plan.config_dir, plan.skill))
    _write_text(os.path.join(raw_dir, "config.json"), json.dumps(config, indent=2, sort_keys=True) + "\n")
    _write_text(os.path.join(raw_dir, "skill-diagnostic.json"), json.dumps(skill_diagnostic(plan, results), indent=2, sort_keys=True) + "\n")


def skill_diagnostic(plan: Plan, results: list[RunResult]) -> dict:
    """Fire rate on ambiguous runs and false fires on clear runs: the numbers the K4 justification quotes, not a pass rule."""
    ambiguous = [result for result in results if not result.case.is_clear]
    clear = [result for result in results if result.case.is_clear]
    return {
        "skill": plan.skill,
        "ambiguous_runs": len(ambiguous), "ambiguous_fired": sum(1 for result in ambiguous if result.record.facts.fired(plan.skill)),
        "clear_runs": len(clear), "clear_false_fires": sum(1 for result in clear if result.record.facts.fired(plan.skill)),
    }


def observed_model(results: list[RunResult]) -> str | None:
    return next((result.record.facts.stream.init.get("model") for result in results if result.record.facts.stream.init), None)


def append_eval_lines(plan: Plan, verdicts: list[CaseVerdict], splits: list[SplitVerdict], model: str) -> None:
    path = os.path.join(env.logs_dir(), "keel-evals.jsonl")
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for verdict in verdicts:
        append_jsonl(path, {"ts": ts, "eval_id": plan.eval_id + CASE_SUFFIX, "rule_id": plan.eval_id, "case": verdict.case.id, "pass": verdict.passed, "model": model})
    summary = "%s %s" % ("suite" if plan.full_run else "subset", " ".join("%s=%d/%d" % (split.split, split.passed_cases, split.cases) for split in splits))
    append_jsonl(path, {"ts": ts, "eval_id": plan.summary_eval_id, "rule_id": plan.eval_id, "case": summary, "pass": suite_passes(splits), "model": model})


def build_report(plan: Plan, raw_dir: str, verdicts: list[CaseVerdict], splits: list[SplitVerdict], faults: list[RunResult], model: str, diagnostic: dict) -> dict:
    return {
        "eval_id": plan.summary_eval_id, "rule_id": plan.eval_id,
        "pass": None if faults else suite_passes(splits), "written": not faults, "model": model, "raw_dir": raw_dir,
        "splits": {split.split: {"cases": split.cases, "passed": split.passed_cases, "pass": split.passed} for split in splits},
        "cases": [{"id": v.case.id, "split": v.case.split, "kind": v.case.kind, "runs": v.runs, "pass": v.passed} for v in verdicts],
        "faults": [{"case": result.case.id, "run": result.index, "reason": result.fault} for result in faults],
        "skill": diagnostic,
    }


def print_summary(report: dict, raw_dir: str) -> None:
    splits = " ".join("%s %d/%d" % (name, split["passed"], split["cases"]) for name, split in report["splits"].items())
    if report["faults"]:
        verdict = "FAULT (%d run(s)); nothing written" % len(report["faults"])
    else:
        verdict = "%s; wrote %s" % ("PASS" if report["pass"] else "FAIL", report["eval_id"])
    print("eval %s: %s -> %s; raw: %s" % (report["rule_id"], splits, verdict, raw_dir), file=sys.stderr)


def _write_text(path: str, text: str) -> None:
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text)


if __name__ == "__main__":
    run_main(main)

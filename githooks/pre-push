#!/bin/bash
set -e
keel_home=$(cd -P "$(dirname "$0")/.." && pwd)
boundary=$keel_home/measure/boundary

pushes_content() {
  case "$1" in *[!0]*) return 0 ;; esac
  return 1
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if pushes_content "$local_sha"; then
    "$boundary" --range "$remote_sha..$local_sha" >/dev/null || { status=$?; break; }
  fi
done

case "$status" in
  0) exit 0 ;;
  1) echo "pre-push: pushed commits hit the public boundary (listed above); rewrite them before pushing." >&2 ;;
  2) echo "pre-push: boundary scan could not run (missing or empty overlay lexicon? set KEEL_OVERLAY_DIR)." >&2 ;;
  *) echo "pre-push: boundary scan failed with exit $status (unknown remote commit? git fetch first)." >&2 ;;
esac
exit 1

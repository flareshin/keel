{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${KEEL_DATA_DIR:-$HOME/.claude}/state/keel/node-compile-cache\" node {{KEEL}}/hooks/ship-gate/ship-gate.ts",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${KEEL_DATA_DIR:-$HOME/.claude}/state/keel/node-compile-cache\" node {{KEEL}}/hooks/git-guard/git-guard.ts",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${KEEL_DATA_DIR:-$HOME/.claude}/state/keel/node-compile-cache\" node {{KEEL}}/hooks/report-gate/report-gate.ts",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${KEEL_DATA_DIR:-$HOME/.claude}/state/keel/node-compile-cache\" node {{KEEL}}/hooks/model-assign/model-assign.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${KEEL_DATA_DIR:-$HOME/.claude}/state/keel/node-compile-cache\" node {{KEEL}}/hooks/report-gate/report-gate.ts",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

--- a/shop/orders.py
+++ b/shop/orders.py
@@ -3,3 +3,8 @@ import sqlite3
 
 def open_orders(conn: sqlite3.Connection) -> list[tuple]:
     return conn.execute("SELECT id, customer, total FROM orders WHERE status = ?", ("open",)).fetchall()
+
+
+def orders_of(conn: sqlite3.Connection, customer: str) -> list[tuple]:
+    query = f"SELECT id, total FROM orders WHERE customer = '{customer}' ORDER BY id"
+    return conn.execute(query).fetchall()

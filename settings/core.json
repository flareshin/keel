{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{KEEL}}/hooks/ship-gate/ship-gate.py",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{KEEL}}/hooks/git-guard/git-guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{KEEL}}/hooks/report-gate/report-gate.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{KEEL}}/hooks/model-assign/model-assign.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{KEEL}}/hooks/report-gate/report-gate.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{KEEL}}/hooks/handoff/handoff.py --auto",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

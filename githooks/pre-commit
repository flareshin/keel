#!/bin/bash
# Blocks a commit whose staged lines hit the public-boundary rules (overlay lexicon, regexes, generic rules).
# Install: git config core.hooksPath githooks
set -e
keel_home=${KEEL_HOME:-$(cd -P "$(dirname "$0")/.." && pwd)}
boundary=${KEEL_BOUNDARY:-$keel_home/measure/boundary}

status=0
"$boundary" --staged >/dev/null || status=$?
[ "$status" -eq 0 ] && exit 0
echo "pre-commit: commit blocked by the public-boundary scan (exit $status; reason above)." >&2
exit 1
